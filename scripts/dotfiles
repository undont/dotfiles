_help_main() {
    print_logo
    cat <<'EOF'
dotfiles: manage your dots

USAGE
  dotfiles <command> [options]    (shorthand: dot)
  dotfiles help <command>         Show detailed help for a command

COMMANDS
  update    -u    Pull latest and apply (incremental)
  status    -s    Version, sync status, local changes
  health          Run full health check
  set             Configure DEV_ROOT / PROJECTS_ROOT
  theme     -t    Manage colour themes
  links     -l    Show managed symlinks
  diff      -d    Show copy-on-install file diffs
  sync            Sync copy-on-install files from repo
  export          Export local layer to the private repo
  import          Import local layer from the private repo
  local           Manage the private local-layer repo
  aliases   -a    Show shell aliases and shortcuts (also: alias, cheat)
  notes     -n    Browse changelog in pager
  version   -v    Print the version (also: -V, --version)
  edit      -e    Open dotfiles or a local config in $EDITOR
  cd              cd into dotfiles or a target's directory

For details on any command:
  dotfiles help <command>
  dotfiles <command> --help
EOF
}

# ─── Dispatcher ───────────────────────────────────────────────────────

main() {
    local cmd
    cmd=$(_canonical_cmd "${1:-help}")
    shift || true

    # `theme` passes help on to its child scripts, and `help` takes a topic
    if [[ "$cmd" != theme && "$cmd" != help ]] &&
        [[ "${1:-}" == -h || "${1:-}" == --help || "${1:-}" == help ]]; then
        cmd_help "$cmd"
        return
    fi

    case "$cmd" in
        update) cmd_update "$@" ;;
        status) cmd_status "$@" ;;
        health) cmd_health "$@" ;;
        set) cmd_set "$@" ;;
        theme) cmd_theme "$@" ;;
        links) cmd_links "$@" ;;
        diff) cmd_diff "$@" ;;
        sync) cmd_sync "$@" ;;
        export) cmd_export "$@" ;;
        import) cmd_import "$@" ;;
        local) cmd_local "$@" ;;
        aliases) cmd_aliases "$@" ;;
        notes) cmd_notes "$@" ;;
        version) cmd_version "$@" ;;
        edit) cmd_edit "$@" ;;
        cd) cmd_cd "$@" ;;
        help) cmd_help "$@" ;;
        *)
            error "Unknown command: $cmd"
            echo ""
            _help_main
            exit 1
            ;;
    esac
}

main "$@"
