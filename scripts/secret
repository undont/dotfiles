#!/usr/bin/env bash
# secrets as NAME=value lines in ~/.config/dotfiles/secrets (mode 600), read
# one at a time and never exported
# usage: secret NAME            print NAME's value
#        secret set NAME        store NAME, read hidden from the terminal or from stdin
#        secret list            print the stored names
#        secret import [FILE]   copy the exports in FILE (default ~/.config/zsh/secrets.zsh)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=scripts/_lib/common.sh
source "$SCRIPT_DIR/_lib/common.sh"

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
SECRETS_FILE="$CONFIG_HOME/dotfiles/secrets"

usage() {
    sed -n '4,7s/^# \{0,1\}//p' "${BASH_SOURCE[0]}"
}

valid_name() {
    [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]
}

secret_get() {
    local name="$1" line
    [[ -f "$SECRETS_FILE" ]] || return 1
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" == "$name="* ]]; then
            printf '%s\n' "${line#*=}"
            return 0
        fi
    done <"$SECRETS_FILE"
    return 1
}

# rewrites the file through a mktemp copy, which is created 600
secret_store() {
    local name="$1" value="$2" tmp line
    mkdir -p "$(dirname "$SECRETS_FILE")"
    tmp=$(mktemp "$SECRETS_FILE.XXXXXX")
    if [[ -f "$SECRETS_FILE" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            [[ "$line" == "$name="* ]] && continue
            printf '%s\n' "$line"
        done <"$SECRETS_FILE" >"$tmp"
    fi
    printf '%s=%s\n' "$name" "$value" >>"$tmp"
    mv "$tmp" "$SECRETS_FILE"
}

cmd_set() {
    local name="${1:-}" value=""
    if ! valid_name "$name"; then
        usage >&2
        return 2
    fi
    if [[ $# -gt 1 ]]; then
        error "secret set reads the value from a prompt or stdin, not an argument (it would stay in shell history)"
        return 2
    fi
    if [[ -t 0 ]]; then
        read -rsp "$name: " value
        printf '\n' >&2
    else
        IFS= read -r value || true
    fi
    if [[ -z "$value" ]]; then
        error "Empty value, nothing stored"
        return 1
    fi
    secret_store "$name" "$value"
    success "Stored $name"
}

cmd_list() {
    [[ -f "$SECRETS_FILE" ]] || return 0
    sed -nE 's/^([A-Za-z_][A-Za-z0-9_]*)=.*/\1/p' "$SECRETS_FILE"
}

cmd_import() {
    local file="${1:-$CONFIG_HOME/zsh/secrets.zsh}" name value copied=0
    if [[ ! -f "$file" ]]; then
        error "No file at $file"
        return 1
    fi

    local -a names
    mapfile -t names < <(sed -nE 's/^[[:space:]]*export[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)=.*/\1/p' "$file")
    set +u
    # shellcheck disable=SC1090
    source "$file"
    set -u

    for name in "${names[@]}"; do
        value="${!name:-}"
        if [[ -z "$value" || "$value" == your_* || "$value" == *$'\n'* ]]; then
            printf "  ${GREY}skip${NC} %s (empty, placeholder or multi-line)\n" "$name"
            continue
        fi
        if secret_get "$name" >/dev/null; then
            printf "  ${GREY}skip${NC} %s (already stored)\n" "$name"
            continue
        fi
        secret_store "$name" "$value"
        printf "  ${GREEN}✓${NC} %s\n" "$name"
        copied=$((copied + 1))
    done

    echo ""
    success "Copied $copied secret(s) into $SECRETS_FILE"
    info "Check one with: secret <NAME>, then delete $file"
}

case "${1:-}" in
    set)
        shift
        cmd_set "$@"
        ;;
    list) cmd_list ;;
    import)
        shift
        cmd_import "$@"
        ;;
    "" | -h | --help | help) usage ;;
    *)
        if ! valid_name "$1"; then
            usage >&2
            exit 2
        fi
        if ! secret_get "$1"; then
            error "No secret named $1"
            exit 1
        fi
        ;;
esac
