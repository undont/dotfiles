#!/usr/bin/env bash
set -euo pipefail

# ══════════════════════════════════════════════════════════════
# Theme Switcher for tmux, ghostty, gh-dash & yazi
# ══════════════════════════════════════════════════════════════
# usage:
#   theme-switch <theme-name> [--no-reload] [--quiet|-q] [--verbose|-v]
#   theme-switch random [--no-reload] [--quiet|-q] [--verbose|-v]
#   theme-switch list
#   theme-switch current
#   theme-switch help
#
# DOTFILES_NO_RELOAD=1 implies --no-reload, including when theme-delete calls
# this script; the test suites set it

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}")")" && pwd)"
DOTFILES_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# shellcheck source=scripts/_lib/common.sh
source "$DOTFILES_ROOT/scripts/_lib/common.sh"
# shellcheck source=scripts/_lib/ghdash.sh
source "$DOTFILES_ROOT/scripts/_lib/ghdash.sh"
# shellcheck source=scripts/_lib/clipboard.sh
source "$DOTFILES_ROOT/scripts/_lib/clipboard.sh"

# command name shown in help: set by `dotfiles theme switch` when delegated,
# the script basename otherwise
invoked_as="${DOTFILES_INVOKED_AS:-$(basename "$0")}"

# writes <template> to <output> with each {{KEY}} replaced by the shell
# variable KEY, failing on any placeholder whose variable is unset. needs $LUA
# usage: render_template <template> <output>
render_template() {
    local template="$1" output="$2"
    local tmp="${output}.tmp.$$"
    mkdir -p "$(dirname "$output")"

    # exports stay inside the subshell, away from the reload scripts
    if ! (
        for var in $(compgen -v); do
            # shellcheck disable=SC2163
            [[ "$var" =~ ^[A-Z][A-Z0-9_]*$ ]] && export "$var"
        done
        exec "$LUA" "$DOTFILES_ROOT/scripts/_lib/render-template.lua" "$template"
    ) >"$tmp"; then
        rm -f "$tmp"
        return 1
    fi
    mv "$tmp" "$output"
}

# per-step timing to stderr when THEME_SWITCH_TIMING=1
_lap_last="${EPOCHREALTIME:-0}"
lap() {
    [[ "${THEME_SWITCH_TIMING:-}" == "1" ]] || return 0
    local now="$EPOCHREALTIME"
    printf '%7.0f ms  %s\n' "$(bc <<<"($now - $_lap_last) * 1000")" "$1" >&2
    _lap_last="$now"
}

THEMES_DIR="$DOTFILES_ROOT/themes"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles"
CURRENT_THEME_FILE="$CONFIG_DIR/current-theme"

TMUX_TEMPLATE="$DOTFILES_ROOT/tmux/tmux.conf.template"
TMUX_OUTPUT="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/tmux.conf"
GHOSTTY_TEMPLATE="$DOTFILES_ROOT/ghostty/config.template"

# ghostty reads the XDG location on every platform
GHOSTTY_OUTPUT="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/config"
GH_DASH_TEMPLATE="$DOTFILES_ROOT/gh-dash/config.yml.template"
GH_DASH_OUTPUT="$GHDASH_BASE"
YAZI_TEMPLATE="$DOTFILES_ROOT/yazi/theme.toml.template"
YAZI_OUTPUT="${XDG_CONFIG_HOME:-$HOME/.config}/yazi/theme.toml"

# ══════════════════════════════════════════════════════════════
# Theme Output Functions (different style from common.sh)
# ══════════════════════════════════════════════════════════════

theme_error() { printf "${RED}✗${NC} %s\n" "$1" >&2; }
theme_success() { printf "${GREEN}✓${NC} %s\n" "$1"; }
theme_info() { printf "${CYAN}•${NC} %s\n" "$1"; }
theme_warn() { printf "${YELLOW}!${NC} %s\n" "$1"; }

# hand-crafted themes, then the generated ones on disk
list_themes() {
    local current_theme=""
    if [[ -f "$CURRENT_THEME_FILE" ]]; then
        current_theme=$(cat "$CURRENT_THEME_FILE")
    fi

    printf "\n${CYAN}Custom themes:${NC}\n\n"

    for theme_file in "$THEMES_DIR"/*.theme; do
        if [[ -f "$theme_file" ]]; then
            local theme_name
            theme_name=$(basename "$theme_file" .theme)
            # shellcheck disable=SC1090
            source "$theme_file"

            local tags=""
            if [[ "$current_theme" == "$theme_name" ]]; then
                tags=" ${GREEN}#current${NC}"
            fi

            printf "  ${CYAN}•${NC} %s - %s${YELLOW} #custom${NC}%b\n" "$theme_name" "$THEME_NAME" "$tags"
        fi
    done

    local has_generated=false
    for theme_file in "$THEMES_DIR/generated/"*.theme; do
        if [[ -f "$theme_file" ]]; then
            if [[ "$has_generated" == "false" ]]; then
                printf "\n${CYAN}Generated themes:${NC}\n\n"
                has_generated=true
            fi

            local theme_name
            theme_name=$(basename "$theme_file" .theme)
            # shellcheck disable=SC1090
            source "$theme_file"

            local tags=""
            if [[ "$current_theme" == "$theme_name" ]]; then
                tags=" ${GREEN}#current${NC}"
            fi

            printf "  ${CYAN}•${NC} %s - %s%b\n" "$theme_name" "$THEME_NAME" "$tags"
        fi
    done

    if [[ -x "$SCRIPT_DIR/generate-theme" ]]; then
        local available_count
        available_count=$("$SCRIPT_DIR/generate-theme" list 2>/dev/null | wc -l | tr -d ' ' || true)
        if [[ "$available_count" -gt 0 ]]; then
            printf "\n  ${CYAN}%s Ghostty themes available.${NC} Use 'dotfiles theme switch <name>' to auto-generate.\n" "$available_count"
            printf "  Run 'dotfiles theme generate list' for the full list.\n"
        fi
    fi

    printf "\n"
}

usage() {
    printf "\n${CYAN}Usage:${NC}\n"
    printf "  %s <theme-name> [--no-reload] [--quiet] [--verbose]\n" "$invoked_as"
    printf "  %s random [--no-reload] [--quiet] [--verbose]\n" "$invoked_as"
    printf "  %s list\n" "$invoked_as"
    printf "  %s current\n" "$invoked_as"
    printf "  %s help\n" "$invoked_as"
    printf "\n${CYAN}Options:${NC}\n"
    printf "  --no-reload    Generate config files without reloading tmux/ghostty\n"
    printf "  --quiet, -q    Suppress output\n"
    printf "  --verbose, -v  Show each generate and reload step\n"
    printf "\n${CYAN}Examples:${NC}\n"
    printf "  %s dracula\n" "$invoked_as"
    printf "  %s random\n" "$invoked_as"
    printf "  %s tokyo-night --no-reload\n" "$invoked_as"
    printf "\n"
}

get_current_theme() {
    if [[ -f "$CURRENT_THEME_FILE" ]]; then
        cat "$CURRENT_THEME_FILE"
    else
        echo "dracula"
    fi
}

# a random ghostty theme, skipping bright ones and the current theme
random_theme() {
    local all bright
    all=$("$SCRIPT_DIR/generate-theme" list 2>/dev/null)
    bright=$("$SCRIPT_DIR/generate-theme" bright-list 2>/dev/null)
    comm -23 <(printf '%s\n' "$all" | sort) <(printf '%s\n' "$bright" | sort) |
        grep -vxF "$(get_current_theme)" |
        awk -v seed="$RANDOM" 'BEGIN{srand(seed)} {a[NR]=$0} END{if (NR) print a[int(rand()*NR)+1]}'
}

# render every template for a theme, then reload the tools
apply_theme() {
    local theme_name="$1"
    local no_reload="${2:-false}"
    local quiet="${3:-false}"
    local verbose="${4:-false}"
    local theme_file="$THEMES_DIR/$theme_name.theme"
    local generated=false

    # tier 1: hand-crafted theme
    if [[ -f "$theme_file" ]]; then
        :
    # tier 2: previously generated theme
    elif [[ -f "$THEMES_DIR/generated/$theme_name.theme" ]]; then
        theme_file="$THEMES_DIR/generated/$theme_name.theme"
    # tier 3: generate from a ghostty theme
    else
        if [[ "$verbose" == "true" ]]; then
            theme_info "Theme '$theme_name' not found locally, checking Ghostty themes..."
        fi
        local generated_name quiet_flag="--quiet"
        [[ "$verbose" == "true" ]] && quiet_flag=""
        if generated_name=$("$SCRIPT_DIR/generate-theme" "$theme_name" $quiet_flag); then
            theme_file="$THEMES_DIR/generated/$generated_name.theme"
            generated=true
        else
            [[ "$quiet" != "true" ]] && theme_error "Theme '$theme_name' not found"
            [[ "$quiet" != "true" ]] && theme_info "Run 'dotfiles theme list' to see available themes"
            return 1
        fi
    fi

    # shellcheck disable=SC1090
    source "$theme_file"

    # derives status bar, pane border and fzf colours from the base colours
    # shellcheck disable=SC1091
    source "$THEMES_DIR/theme-defaults.sh"
    apply_theme_defaults
    lap "source + defaults"

    local required_vars=(
        THEME_NAME TMUX_BG_PRIMARY TMUX_FG_PRIMARY TMUX_STATUS_BG TMUX_STATUS_FG
        GHOSTTY_BACKGROUND GHOSTTY_FOREGROUND
    )
    for var in "${required_vars[@]}"; do
        if [[ -z "${!var:-}" ]]; then
            theme_error "Theme '$theme_name' is missing required variable: $var"
            return 1
        fi
    done

    local LUA
    LUA=$(find_lua) || return 1

    [[ "$verbose" == "true" ]] && theme_info "Applying theme: $THEME_NAME"

    if [[ -f "$TMUX_TEMPLATE" ]]; then
        # platform clipboard command, shared with the tmux scripts
        local CLIPBOARD_CMD
        CLIPBOARD_CMD="$(clipboard_copy_cmd)"

        render_template "$TMUX_TEMPLATE" "$TMUX_OUTPUT" || return 1
        [[ "$verbose" == "true" ]] && theme_success "Generated tmux configuration"
        lap "render tmux"
    else
        [[ "$quiet" != "true" ]] && theme_warn "Tmux template not found, skipping"
    fi

    if [[ -f "$GHOSTTY_TEMPLATE" ]]; then
        # keybindings use {{PLATFORM_MOD}} in the template
        local PLATFORM_MOD="alt" PLATFORM_CONFIG="# Linux"
        if is_macos; then
            PLATFORM_MOD="opt"
            PLATFORM_CONFIG="macos-icon = glass
macos-icon-frame = chrome
macos-option-as-alt = left"
        fi

        render_template "$GHOSTTY_TEMPLATE" "$GHOSTTY_OUTPUT" || return 1
        [[ "$verbose" == "true" ]] && theme_success "Generated ghostty configuration"
        lap "render ghostty"

        # ghostty errors on a missing config-file include
        local ghostty_local="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/local"
        if [[ ! -f "$ghostty_local" ]]; then
            touch "$ghostty_local"
        fi
    else
        [[ "$quiet" != "true" ]] && theme_warn "Ghostty template not found, skipping"
    fi

    if [[ -f "$GH_DASH_TEMPLATE" ]]; then
        render_template "$GH_DASH_TEMPLATE" "$GH_DASH_OUTPUT" || return 1

        # merge user local overrides on top
        if [[ "$quiet" == "true" ]]; then
            ghdash_merge_local --quiet
        elif [[ "$verbose" == "true" ]]; then
            ghdash_merge_local
        else
            ghdash_merge_local >/dev/null
        fi

        [[ "$verbose" == "true" ]] && theme_success "Generated gh-dash configuration"
        lap "render gh-dash (+merge local)"
    fi

    if [[ -f "$YAZI_TEMPLATE" ]]; then
        local yazi_dir
        yazi_dir="$(dirname "$YAZI_OUTPUT")"
        # only write when the yazi config dir is a real directory (per-file
        # symlinks). a whole-dir symlink into the repo would put the generated
        # theme in version control; the 0.2.109 migration converts it
        if [[ -d "$yazi_dir" && ! -L "$yazi_dir" ]]; then
            render_template "$YAZI_TEMPLATE" "$YAZI_OUTPUT" || return 1
            [[ "$verbose" == "true" ]] && theme_success "Generated yazi theme"
            lap "render yazi"
        else
            [[ "$quiet" != "true" ]] && theme_warn "Yazi config dir is a legacy symlink; run 'dotfiles update' to migrate"
        fi
    fi

    mkdir -p "$CONFIG_DIR"
    echo "$theme_name" >"$CURRENT_THEME_FILE"
    lap "write current-theme"

    # theme history, for MRU sorting in the picker
    local theme_history="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/theme-history"
    mkdir -p "$(dirname "$theme_history")"
    printf '%s\n' "$theme_name" >>"$theme_history"
    if [[ $(wc -l <"$theme_history") -gt 100 ]]; then
        tail -100 "$theme_history" >"$theme_history.tmp" && mv "$theme_history.tmp" "$theme_history"
    fi

    if [[ "$no_reload" != "true" ]]; then
        # shellcheck disable=SC2033
        if command -v tmux >/dev/null 2>&1 && tmux info &>/dev/null; then
            # tpm re-init takes about 2s, so the reload runs detached.
            # XDG location first, then ~/.tmux.conf
            (
                tmux source-file "$TMUX_OUTPUT" ||
                    { [[ -f "$HOME/.tmux.conf" ]] && tmux source-file "$HOME/.tmux.conf"; }
            ) >/dev/null 2>&1 &
            [[ "$verbose" == "true" ]] && theme_success "Reloading tmux configuration in the background"
        else
            # tmux missing or no server running
            [[ "$verbose" == "true" ]] && theme_success "Theme files generated (start tmux to see changes)"
        fi

        # the script detects whether ghostty is running
        lap "reload tmux"
        if [[ -f "$DOTFILES_ROOT/tmux/scripts/themes/reload-ghostty.sh" ]]; then
            "$DOTFILES_ROOT/tmux/scripts/themes/reload-ghostty.sh"
            [[ "$verbose" == "true" ]] && theme_success "Reloaded ghostty configuration"
        fi
        lap "reload ghostty"

        # themes a rex app on this machine and the other rex hosts; skipped
        # when rex is absent
        "$DOTFILES_ROOT/tmux/scripts/themes/reload-rex.sh" "$theme_name" "$theme_file"
        lap "reload rex"

        if [[ -f "$DOTFILES_ROOT/tmux/scripts/themes/reload-fzf.sh" ]]; then
            "$DOTFILES_ROOT/tmux/scripts/themes/reload-fzf.sh"
            [[ "$verbose" == "true" ]] && theme_success "Reloaded FZF theme colours"
        fi
        lap "reload fzf"
    fi

    if [[ "$quiet" != "true" ]]; then
        local readable=true
        # generate-theme already printed the report for a theme it just made
        if [[ "$verbose" == "true" && "$generated" != "true" ]]; then
            "$SCRIPT_DIR/theme-contrast-check" "$theme_file" || readable=false
        elif ! "$SCRIPT_DIR/theme-contrast-check" "$theme_file" >/dev/null 2>&1; then
            readable=false
        fi
        [[ "$verbose" == "true" ]] && printf "\n"
        if [[ "$readable" == "true" ]]; then
            theme_success "Theme applied: $THEME_NAME"
        elif [[ "$verbose" == "true" ]]; then
            printf "${GREEN}✓${NC} Theme applied: %s ${YELLOW}(some colours might be hard to read)${NC}\n" "$THEME_NAME"
        else
            printf "${GREEN}✓${NC} Theme applied: %s ${YELLOW}(some colours might be hard to read, -v for details)${NC}\n" "$THEME_NAME"
        fi
        if [[ "$no_reload" == "true" ]]; then
            theme_info "Run 'tmux source ~/.config/tmux/tmux.conf' to apply tmux changes"
            theme_info "Restart ghostty to see changes"
        fi
    fi
}

# ══════════════════════════════════════════════════════════════
# Main
# ══════════════════════════════════════════════════════════════

main() {
    local command="${1:-}"
    local no_reload=false
    local quiet=false
    local verbose=false
    [[ -n "${DOTFILES_NO_RELOAD:-}" ]] && no_reload=true

    for arg in "$@"; do
        case "$arg" in
            --no-reload) no_reload=true ;;
            --quiet | -q) quiet=true ;;
            --verbose | -v) verbose=true ;;
        esac
    done

    args=()
    for arg in "$@"; do
        case "$arg" in
            --no-reload | --quiet | -q | --verbose | -v) continue ;;
            *) args+=("$arg") ;;
        esac
    done
    set -- "${args[@]+"${args[@]}"}"
    command="${1:-}"

    case "$command" in
        list)
            list_themes
            ;;
        current)
            current=$(get_current_theme)
            # shellcheck disable=SC1090
            if [[ -f "$THEMES_DIR/$current.theme" ]]; then
                source "$THEMES_DIR/$current.theme"
            elif [[ -f "$THEMES_DIR/generated/$current.theme" ]]; then
                source "$THEMES_DIR/generated/$current.theme"
            else
                THEME_NAME="Unknown"
            fi
            printf "\n${CYAN}Current theme:${NC} %s (%s)\n\n" "$THEME_NAME" "$current"
            ;;
        help | --help | -h)
            usage
            ;;
        random)
            local theme
            theme=$(random_theme) || true
            if [[ -z "$theme" ]]; then
                theme_error "No themes to pick from"
                exit 1
            fi
            apply_theme "$theme" "$no_reload" "$quiet" "$verbose"
            ;;
        "")
            theme_error "No theme specified"
            usage
            exit 1
            ;;
        -*)
            theme_error "Unknown option: $command"
            usage
            exit 1
            ;;
        *)
            apply_theme "$command" "$no_reload" "$quiet" "$verbose"
            ;;
    esac
}

main "$@"
