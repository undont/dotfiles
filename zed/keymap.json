// Zed keymap: nvim-parity layer
//
// mirrors ~/dotfiles/nvim's keybindings as closely as Zed's vim mode allows.
// leader is <space> (matches nvim's mapleader) but Zed has no mapleader variable,
// so every leader sequence below is spelled out literally as "space ..."
//
// reference: https://zed.dev/docs/key-bindings, https://zed.dev/docs/vim
// Zed's own defaults: "zed: open default keymap" from the command palette
[
  // pane management, after the tmux pane bindings (tmux/tmux.conf.template).
  // Workspace scope covers every mode and panel
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "alt-\\": "pane::SplitRight",
      "alt-'": "pane::SplitLeft",
      "alt--": "pane::SplitDown",
      "alt-=": "pane::SplitUp",
      "alt-shift-h": "vim::ResizePaneLeft",
      "alt-shift-j": "vim::ResizePaneDown",
      "alt-shift-k": "vim::ResizePaneUp",
      "alt-shift-l": "vim::ResizePaneRight",
      "alt-z": "vim::MaximizePane",
      "alt-)": "vim::ResetPaneSizes"
    }
  },

  // dock-panel toggles. every text input in Zed (chat, commit message, rename,
  // search) is an Editor node under Workspace, so a bare "Workspace" scope
  // would fire the toggle on a typed "space e" instead of inserting it. the
  // first rule covers normal mode in an editor; the second covers focus paths
  // with no Editor at all (blank workspace, a panel's tree or list).
  // Toggle opens and closes; Zed's default ToggleFocus only focuses
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space e": "project_panel::Toggle",
      "space o": "outline_panel::Toggle",
      "space d": "debug_panel::Toggle",
      "space g": "git_panel::Toggle"
    }
  },
  {
    "context": "Workspace && !Editor",
    "bindings": {
      "space e": "project_panel::Toggle",
      "space o": "outline_panel::Toggle",
      "space d": "debug_panel::Toggle",
      "space g": "git_panel::Toggle"
    }
  },

  // Zed and vim mode bind ctrl-hjkl at the Editor node. precedence is tree
  // depth first, with match order only as a tiebreak at equal depth, so the
  // Workspace-level bindings above lose inside an editor and are repeated here
  // at Editor level. VimControl is normal/visual/operator, so insert-mode
  // ctrl-h still backspaces. the showing_* exclusions avoid a tie with the
  // context-menu block below: a code-action menu opened from normal mode keeps
  // VimControl true
  {
    "context": "Editor && VimControl && !showing_code_actions && !showing_completions",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight"
    }
  },

  // code-action / completion popup navigation: ctrl-j/k alongside Zed's own
  // ctrl-n/ctrl-p
  {
    "context": "Editor && (showing_code_actions || showing_completions)",
    "bindings": {
      "ctrl-j": "editor::ContextMenuNext",
      "ctrl-k": "editor::ContextMenuPrevious"
    }
  },

  // core motions: m/M/gm swap, matches nvim/lua/core/keymaps.lua.
  // native motions, not SendKeystrokes, so counts, operator-pending and visual work
  {
    "context": "Editor && VimControl",
    "bindings": {
      "m": "vim::FirstNonWhitespace", // vim's "^"
      "shift-m": "vim::EndOfLine", // replaces window-middle, as in nvim
      "g m": "vim::PushMark" // vim's mark-set, which bare "m" no longer does
    }
  },

  // picker/menu navigation: ctrl-j/k alongside Zed's own ctrl-n/p, matching the
  // telescope <C-j>/<C-k> mappings in nvim. scoped to the picker's text input so
  // the pane-nav ctrl-j/k above does not apply there
  {
    "context": "Picker > Editor",
    "bindings": {
      "ctrl-j": "menu::SelectNext",
      "ctrl-k": "menu::SelectPrevious"
    }
  },

  // vim mode binds project-panel enter to OpenPermanent, which skips
  // preview-tab reuse and opens in a new pane; Open matches a plain click.
  // "o" defaults to OpenSplitHorizontal and gets the same override
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "enter": "project_panel::Open",
      "o": "project_panel::Open"
    }
  },

  // leader-key workflows (leader = space). Zed's vim mode ships gd/gD/gy/gi/
  // grn/grr/gri/gra/gx/K/ctrl-a/ctrl-x/]c/[c/ys/cs/ds itself; this block covers
  // the rest
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      // LSP: the gr* aliases the nvim config adds to the nvim defaults
      "g r d": "editor::GoToDefinition",
      "g r shift-d": "editor::GoToDeclaration",
      "g r t": "editor::GoToTypeDefinition",
      "g r f": "editor::ToggleCodeActions", // closest to "fix all"; pick the fix from the menu
      "g shift-o": "outline::Toggle", // nvim gO: document symbols
      "g shift-w": "project_symbols::Toggle", // nvim gW: workspace symbols
      "space f": "editor::Format",
      "space l r": "editor::RestartLanguageServer",
      "space l h": "editor::ToggleInlayHints",
      "space l l": "lsp_tool::ToggleMenu", // Zed default is ctrl-cmd-l

      // folding: zr/zc/zm -> zR/zC/zM, matches nvim/lua/core/folding.lua
      "z r": "editor::UnfoldAll",
      "z c": "editor::FoldRecursive",
      "z m": "editor::FoldAll",

      // fuzzy-finding: telescope pickers -> Zed's equivalent panels
      "space s f": "file_finder::Toggle",
      "space s g": "pane::DeploySearch",
      "space s s": "command_palette::Toggle",
      "space s d": "diagnostics::Deploy",
      "space space": "tab_switcher::Toggle", // nvim's <leader><leader> buffer picker

      // file explorer / buffers
      "space b d": "pane::CloseActiveItem",
      "space b a": "pane::CloseAllItems",

      // git hunks: gitsigns' <leader>H* -> Zed's git actions (]c/[c are built in)
      "space H s": "git::ToggleStaged",
      "space H r": "git::Restore",
      "space H S": "git::StageAll",
      "space H b": "editor::BlameHover",
      "space H B": "editor::ToggleGitBlameInline",

      // diagnostics quickfix-equivalent (Zed has no quickfix list)
      "space x x": "diagnostics::Deploy",

      // nvim's <leader>q detects the project type (build.lua); Zed has no
      // marker-file detection, so this opens a picker over tasks.json
      "space q": "task::Spawn"
    }
  },
  {
    // project-search results (space s g): n/N step through matches.
    // scoped to "ProjectSearchView > Editor" so it overrides vim's own n/N only
    // in the results view; a Pane-level bind is shadowed by vim's n/N there
    "context": "ProjectSearchView > Editor && vim_mode == normal",
    "bindings": {
      "n": "search::SelectNextMatch",
      "shift-n": "search::SelectPreviousMatch"
    }
  }
]
