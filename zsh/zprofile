# =============================================================================
# ZSH PROFILE (Login Shell Configuration)
# =============================================================================
# sourced for login shells only (a new terminal window, an ssh session). holds
# PATH entries added by third-party installers on this machine; the entries the
# dotfiles framework owns live in zsh/dotfiles.zsh. interactive config
# (aliases, functions, prompt) goes in ~/.zshrc
#
# load order: .zshenv → .zprofile (login) → .zshrc (interactive) → .zlogin

# dedupes $path across all later additions, including the framework's
typeset -U path PATH

# homebrew environment: HOMEBREW_PREFIX, PATH, MANPATH, INFOPATH, and
# site-functions on fpath (needed by compinit)
if [[ -f /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
elif [[ -f /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# bun global packages (bun install -g)
export PATH="$HOME/.bun/bin:$PATH"

# user-local binaries: install target for `uv tool install` and other CLIs
export PATH="$HOME/.local/bin:$PATH"

# /usr/sbin and /sbin hold tools like smartctl that are not on a non-root
# user's default PATH on Debian/Ubuntu. appended so they never shadow brew or
# user binaries; already on PATH on macOS, Arch and Fedora
[[ -d /usr/sbin ]] && export PATH="$PATH:/usr/sbin"
[[ -d /sbin ]] && export PATH="$PATH:/sbin"

# terminal emulators don't forward COLORTERM over ssh, so remote TUIs see only
# TERM=*-256color and downsample 24-bit colours. the driving terminal
# (ghostty + tmux) is truecolor, so set it when missing in an ssh session
if [[ -z "${COLORTERM:-}" && -n "${SSH_CONNECTION:-}" ]]; then
  export COLORTERM=truecolor
fi
